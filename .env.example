# CockroachDB / PostgreSQL connection string (with or without sslmode)
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
# Optional: custom CA cert PEM if verify-full needs it (rarely needed)
# DATABASE_CA=

# Where customer email orders (mailto) point, and the default admin login email.
# NOTE: whatsapp + contact_email are seeded into the DB on first run and can be
# edited from the Admin dashboard (Settings tab). These env vars are only the
# initial/fallback values.
ADMIN_WHATSAPP=15551234567
CONTACT_EMAIL=hello@saguaroseedvault.com
ADMIN_EMAIL=hello@saguaroseedvault.com

# First-login admin password. Change it from the admin dashboard after first login.
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# Cloudinary. Remote product images (Unsplash / allreptiles.ca Shopify CDN) are
# delivered through Cloudinary's fetch pipeline, which resizes and auto-formats
# them (WebP/AVIF) on the fly. Leave the cloud name empty to disable and serve
# the original URLs untouched.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Only needed if you later upload/migrate images into Cloudinary yourself.
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=